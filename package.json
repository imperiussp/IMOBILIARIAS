{
  "name": "imobiliarias",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @imobiliarias/web dev",
    "dev:mobile": "pnpm --filter @imobiliarias/mobile start",
    "build:web": "pnpm --filter @imobiliarias/web build",
    "typecheck": "pnpm -r typecheck",
    "supabase:guard": "node scripts/verify-supabase-target.mjs",
    "edge:guards": "node scripts/check-edge-function-guards.mjs",
    "migration:safety": "node scripts/check-migration-safety.mjs",
    "env:contract": "node scripts/check-env-contract.mjs",
    "homologation:assets": "node scripts/check-homologation-assets.mjs"
  }
}
