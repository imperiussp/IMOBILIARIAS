{
  "expo": {
    "name": "LENOY Imobiliárias",
    "slug": "lenoy-imobiliarias",
    "owner": "moto-connect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o LENOY Imobiliárias acesse suas fotos para anexar imagens aos imóveis.",
          "cameraPermission": "Permita que o LENOY Imobiliárias use a câmera para fotografar os imóveis."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.lenoy.imobiliarias",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Permita notificações para receber novos contatos e mensagens de clientes."
      }
    },
    "android": {
      "package": "br.com.lenoy.imobiliarias",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "a229bb02-47fe-40d2-8a06-148e34a7ccab"
      }
    }
  }
}
