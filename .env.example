# IMPORTANTE: use exclusivamente o projeto Supabase do IMOBILIARIAS.
# Nunca reutilize URL, project ref ou chave de Moto Connect, LENOY, Lê+ ou qualquer outro projeto.
# Projeto exclusivo confirmado em 22/08/2026: IMOBILIARIAS / sa-east-1.

# Guard obrigatório antes de qualquer migration/deploy de banco.
# Os dois valores apontam para o MESMO project ref exclusivo do IMOBILIARIAS.
IMOBILIARIAS_SUPABASE_PROJECT_REF=rvjsonspplqelktzwusu
SUPABASE_PROJECT_REF=rvjsonspplqelktzwusu

# WEB — valores públicos permitidos no navegador.
# Prefira a chave publishable moderna; ANON_KEY permanece apenas como fallback legado.
NEXT_PUBLIC_SUPABASE_URL=https://rvjsonspplqelktzwusu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Identificação explícita do build publicado.
# Preencha no pipeline/hosting com o SHA real e um rótulo legível da versão.
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_BUILD_LABEL=

# APLICATIVO — valores públicos permitidos no app.
# Prefira a chave publishable moderna; ANON_KEY permanece apenas como fallback legado.
EXPO_PUBLIC_SUPABASE_URL=https://rvjsonspplqelktzwusu.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Domínio principal da plataforma SaaS.
NEXT_PUBLIC_PLATFORM_HOST=imoveis.lenoy.com.br

# URL pública principal da plataforma.
NEXT_PUBLIC_SITE_URL=https://imoveis.lenoy.com.br

# Indexação por buscadores. Deixe false/vazio em homologação.
# Ative somente no lançamento comercial depois de revisar robots/sitemap/SEO.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contato padrão da plataforma/imobiliária (fallback quando aplicável)
NEXT_PUBLIC_WHATSAPP_DEFAULT=

# -----------------------------------------------------------------------------
# VARIÁVEIS SOMENTE DO BACKEND / SUPABASE EDGE FUNCTIONS
# NUNCA colocar SUPABASE_SERVICE_ROLE_KEY, chaves de IA ou segredos abaixo
# em NEXT_PUBLIC_*, EXPO_PUBLIC_* ou dentro do bundle web/mobile.
# -----------------------------------------------------------------------------

SUPABASE_URL=https://rvjsonspplqelktzwusu.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL canônica usada pelas Edge Functions.
PLATFORM_SITE_URL=https://imoveis.lenoy.com.br

# Segredo do orquestrador único de manutenção da plataforma.
# Permite que um único cron acione faturamento, domínios, push e oportunidades.
PLATFORM_MAINTENANCE_SECRET=

# InfinitePay — somente backend do projeto IMOBILIARIAS.
INFINITEPAY_HANDLE=
INFINITEPAY_WEBHOOK_SECRET=

# Manutenção financeira/agendador — somente IMOBILIARIAS.
BILLING_MAINTENANCE_SECRET=

# Dispatcher de push remoto
PUSH_DISPATCH_SECRET=

# Verificação automática de domínios próprios
DOMAIN_VERIFY_SECRET=

# Webhook normalizado de entrada de e-mails.
INBOUND_EMAIL_SECRET=

# IA — Groq é o provedor primário; Gemini é fallback automático.
# Ambos ficam somente nos Secrets das Edge Functions.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Compatibilidade com configuração legada de um único provedor.
# Pode permanecer vazio quando Groq/Gemini estiverem configurados.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# IA de oportunidades para compradores.
# Secret usado pelo agendador que processa a fila; nunca expor no navegador/app.
BUYER_OUTREACH_MAINTENANCE_SECRET=
# Adaptador de entrega. Em produção, aponte para a Edge Function
# deliver-buyer-outreach do próprio projeto, por exemplo:
# https://SEU_PROJECT_REF.supabase.co/functions/v1/deliver-buyer-outreach
BUYER_OUTREACH_WEBHOOK_URL=
# Mesmo segredo deve ser configurado na função process-buyer-opportunities e
# na função deliver-buyer-outreach. Ele protege chamadas internas entre elas.
BUYER_OUTREACH_WEBHOOK_TOKEN=
# Secret recebido pela função buyer-outreach-webhook para eventos normalizados
# de provedores auxiliares.
BUYER_OUTREACH_PROVIDER_WEBHOOK_SECRET=

# WhatsApp Cloud API — somente backend. A versão da Graph API fica em variável
# para não fixar uma versão no código e poder ser atualizada sem novo deploy.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
# Verificação do webhook direto da Meta.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret usado para validar X-Hub-Signature-256 nos POSTs da Meta.
META_APP_SECRET=

# E-mail via Resend — somente backend.
RESEND_API_KEY=
# Ex.: Imobiliária <imoveis@seudominio.com.br>
RESEND_FROM_EMAIL=
# Signing secret (whsec_...) do webhook Resend usado por resend-outreach-webhook.
RESEND_WEBHOOK_SIGNING_SECRET=
